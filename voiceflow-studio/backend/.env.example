# VoiceFlow Studio API settings. Copy to backend/.env and fill in keys.
# Never commit backend/.env; never copy it into other folders or images.

# Host runs use the compose Postgres published on :5433. (Inside Docker,
# compose.yaml overrides this to postgres:5432.)
DATABASE_URL=postgresql+asyncpg://voiceflow:voiceflow@localhost:5433/voiceflow

# Provider keys. Default demo stack: Deepgram STT + OpenAI LLM + Soniox TTS.
# All-OpenAI alternative: only OPENAI_API_KEY is needed (pick OpenAI for STT/TTS in the flow editor).
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
SONIOX_API_KEY=

# Browser origins allowed to call the API: Studio UI + Artemis dashboard.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# When true, api_call nodes return mock_response instead of making HTTP calls.
# Keep true for demos; replays force it regardless.
API_CALL_MOCK=true

# Artemis integration (docs/INTEGRATION_CONTRACT.md).
ARTEMIS_API_URL=http://localhost:8001
ARTEMIS_DASHBOARD_URL=http://localhost:5173
# Trace artifacts (caller / TTS audio). Relative paths resolve against backend/.
ARTIFACTS_DIR=./artifacts
REPLAY_LLM_SEED=7

# Optional comma-separated ICE server URLs for WebRTC, e.g. stun:stun.l.google.com:19302
# Only needed when the browser and the API are on different networks/hosts.
VOICE_ICE_SERVERS=

# DEBUG shows every pipecat frame/prompt; INFO is readable
LOG_LEVEL=INFO
